{
  "name": "serene-reader",
  "version": "2.2.2",
  "private": true,
  "description": "Leitor de ebooks offline-first, acessível e empacotado para Android.",
  "scripts": {
    "dev": "npm run build && http-server www -c-1 -p 8000",
    "build": "node scripts/build.mjs",
    "check:js": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run check:js && npm test && npm run build",
    "android:add": "npm run build && cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/lexend": "5.3.0",
    "@fontsource/literata": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/opendyslexic": "5.3.0",
    "@fontsource/vollkorn": "5.3.0",
    "@mozilla/readability": "0.6.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/por": "1.0.0",
    "dompurify": "3.4.15",
    "jszip": "3.10.2",
    "mammoth": "1.12.3",
    "marked": "12.0.2",
    "pdfjs-dist": "6.3.289",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "6.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@tailwindcss/cli": "4.3.3",
    "http-server": "14.1.1",
    "tailwindcss": "4.3.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "tar": "7.5.22",
    "uuid": "14.0.2"
  }
}
